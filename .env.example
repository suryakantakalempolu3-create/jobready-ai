# Copy this file to .env and fill in your own values. Never commit .env.
SECRET_KEY=change-me-to-a-long-random-string

# ---- MySQL ----
DB_HOST=localhost
DB_PORT=3306
DB_USER=jobready
DB_PASSWORD=change-me
DB_NAME=jobready_ai
# 1 = create any missing tables automatically on start (schema.sql is still the reference). 0 = never touch the schema.
AUTO_CREATE_TABLES=1

# ---- AI (optional). Get a key at https://console.anthropic.com/ . Leave empty for offline mode ----
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

FLASK_DEBUG=0
